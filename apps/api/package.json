    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "pino": "9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
