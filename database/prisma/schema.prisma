generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
  ANONYMIZED
}

enum AuthProvider {
  LOCAL
  MANAGED
}

enum ConsentState {
  GRANTED
  WITHDRAWN
  REVOKED
}

enum UserRoleName {
  STUDENT
  CONTENT_REVIEWER
  ACADEMIC_ADMIN
  PLATFORM_ADMIN
}

enum RoleAssignmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AcademicScopeStatus {
  ACTIVE
  REVOKED
}

enum OnboardingState {
  NOT_STARTED
  PROFILE_IN_PROGRESS
  CONSENT_REQUIRED
  READY_FOR_DIAGNOSTIC
}

enum ConfigurationVersionStatus {
  DRAFT
  APPROVED
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
}

enum ConfigurationApprovalDecision {
  APPROVED
  REJECTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  NUMERIC
  SUBJECTIVE
}

enum QuestionVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
  REJECTED
}

enum AcademicIssueStatus {
  OPEN
  RESOLVED
}

enum PilotStatus {
  DRAFT
  READY
  ACTIVE
  COMPLETED
}

enum QuestionMappingRole {
  PRIMARY
  SECONDARY
}

enum QuestionOriginType {
  AUTHOR_CREATED
  LICENSED_SOURCE
  APPROVED_FIXTURE
}

enum QuestionRightsStatus {
  VERIFIED
  PENDING
  RESTRICTED
  REJECTED
}

enum QuestionReviewType {
  CONTENT
  CONCEPT_MAPPING
  DIFFICULTY
  PROVENANCE
  RIGHTS
}

enum QuestionReviewDecision {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

enum AssessmentTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AssessmentSessionState {
  READY
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum DiagnosticStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

enum DiagnosticStopReason {
  SUFFICIENT_TARGET_EVIDENCE
  GAP_LOCALIZED
  MAX_QUESTIONS_REACHED
  NO_ELIGIBLE_CANDIDATE
  USER_STOPPED
  SESSION_EXPIRED
}

enum PracticeGoalType {
  CONCEPT_PRACTICE
  OBJECTIVE_PRACTICE
  REMEDIAL_PRACTICE
  MIXED_REVIEW
}

enum PracticeStatus {
  READY
  ACTIVE
  COMPLETED
  STOPPED
}

enum PracticeStopReason {
  USER_COMPLETED
  USER_STOPPED
  MAX_QUESTIONS_REACHED
  NO_ELIGIBLE_CANDIDATE
}

enum TestType {
  TOPIC
  CHAPTER
  CUSTOM
}

enum TestLifecycleState {
  READY
  ACTIVE
  COMPLETED
  EXPIRED
}

enum AttachmentPurpose {
  DOUBT_IMAGE
  TUTOR_IMAGE
}

enum AttachmentStatus {
  PENDING_UPLOAD
  VALIDATING
  AVAILABLE
  REJECTED
  DELETED
  EXPIRED
}

model User {
  userId                     String                     @id @default(uuid()) @db.Uuid
  authProvider               AuthProvider
  providerSubject            String
  email                      String?
  status                     UserStatus                 @default(PENDING)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  passwordHash               String?
  profile                    StudentProfile?
  consents                   ConsentRecord[]
  roles                      UserRole[]                 @relation("UserRoles")
  grantedRoles               UserRole[]                 @relation("RoleGrantors")
  sessions                   Session[]
  resetTokens                PasswordResetToken[]
  auditEvents                AuditEvent[]
  examGoals                  ExamGoal[]
  configurationVersions      ConfigurationVersion[]     @relation("ConfigurationVersionCreators")
  configurationChanges       ConfigurationChange[]      @relation("ConfigurationChangeActors")
  configurationApprovals     ConfigurationApproval[]
  configurationPublications  ConfigurationPublication[]
  configurationRollbacks     ConfigurationRollback[]
  questionsCreated           Question[]                 @relation("QuestionCreators")
  questionVersionsCreated    QuestionVersion[]          @relation("QuestionVersionCreators")
  questionConceptMapsCreated QuestionConceptMap[]       @relation("QuestionConceptMapCreators")
  questionReviews            QuestionReviewRecord[]
  questionExposures          QuestionExposure[]
  assessmentTemplatesCreated AssessmentTemplate[]       @relation("AssessmentTemplateCreators")
  assessmentSessions         AssessmentSession[]
  assessmentResponses        AssessmentResponse[]
  diagnosticRuns             DiagnosticRun[]
  practiceSessions           PracticeSession[]
  tests                      TestDefinition[]
  academicScopes             AcademicScope[]
  attachments                Attachment[]
  ownedPilots                Pilot[]                  @relation("PilotOwners")
  pilotParticipations        PilotParticipant[]       @relation("PilotParticipants")

  @@unique([authProvider, providerSubject])
  @@index([providerSubject])
  @@index([status])
  @@map("users")
}

model Attachment {
  attachmentId     String            @id @default(uuid()) @db.Uuid
  ownerLearnerId   String            @db.Uuid
  createdByActorId String            @db.Uuid
  purpose          AttachmentPurpose
  objectKey        String            @unique
  originalFilename String
  declaredMimeType String
  idempotencyKey   String
  requestFingerprint String
  sessionId         String?
  interactionId     String?
  detectedMimeType String?
  sizeBytes        Int?
  sha256           String?
  width            Int?
  height           Int?
  status           AttachmentStatus  @default(PENDING_UPLOAD)
  createdAt        DateTime          @default(now())
  validatedAt      DateTime?
  deletedAt        DateTime?
  owner            User              @relation(fields: [ownerLearnerId], references: [userId], onDelete: Restrict)
  @@index([ownerLearnerId, status])
  @@index([ownerLearnerId, purpose, createdAt])
  @@index([ownerLearnerId, sessionId, interactionId, status])
  @@unique([ownerLearnerId, idempotencyKey])
  @@map("attachments")
}

model AcademicScope {
  academicScopeId   String             @id @default(uuid()) @db.Uuid
  learnerId         String             @db.Uuid
  contextId         String
  academicVersionId String
  status            AcademicScopeStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  revokedAt         DateTime?
  learner           User                @relation(fields: [learnerId], references: [userId], onDelete: Restrict)
  @@unique([learnerId, contextId, academicVersionId])
  @@index([contextId, academicVersionId, status])
  @@map("academic_scopes")
}

model PracticeSession {
  practiceSessionId        String              @id @default(uuid()) @db.Uuid
  ownerUserId              String              @db.Uuid
  academicVersionId        String
  assessmentSessionId      String?             @db.Uuid
  goalType                 PracticeGoalType
  targetIds                String[]
  status                   PracticeStatus      @default(READY)
  currentDifficulty        String              @default("MEDIUM")
  consecutiveCorrect       Int                 @default(0)
  questionCount            Int                 @default(0)
  currentPlacementId       String?             @db.Uuid
  currentQuestionVersionId String?             @db.Uuid
  currentAttempt           Int                 @default(0)
  retryCount               Int                 @default(0)
  retryAvailable           Boolean             @default(false)
  hintUsed                 Boolean             @default(false)
  processedResponseIds     String[]
  stopReason               PracticeStopReason?
  lockVersion              Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  startedAt                DateTime?
  completedAt              DateTime?
  owner                    User                @relation(fields: [ownerUserId], references: [userId], onDelete: Restrict)
  academicVersion          SyllabusVersion     @relation(fields: [academicVersionId], references: [canonicalId], onDelete: Restrict)

  @@index([ownerUserId, status, createdAt])
  @@map("practice_sessions")
}

model AssessmentTemplate {
  assessmentTemplateId   String                   @id @default(uuid()) @db.Uuid
  canonicalId            String
  versionNumber          Int
  title                  String
  assessmentType         String
  syllabusVersionId      String
  examId                 String
  subjectId              String
  durationSeconds        Int
  structure              Json
  configurationReference String?
  status                 AssessmentTemplateStatus @default(DRAFT)
  createdByUserId        String                   @db.Uuid
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdBy              User                     @relation("AssessmentTemplateCreators", fields: [createdByUserId], references: [userId], onDelete: Restrict)
  syllabusVersion        SyllabusVersion          @relation(fields: [syllabusVersionId], references: [canonicalId], onDelete: Restrict)
  sessions               AssessmentSession[]

  @@unique([canonicalId, versionNumber])
  @@index([examId, subjectId, status])
  @@map("assessment_templates")
}

model AssessmentSession {
  assessmentSessionId  String                       @id @default(uuid()) @db.Uuid
  ownerUserId          String                       @db.Uuid
  assessmentTemplateId String                       @db.Uuid
  syllabusVersionId    String
  state                AssessmentSessionState       @default(READY)
  createdAt            DateTime                     @default(now())
  startedAt            DateTime?
  expiresAt            DateTime?
  endedAt              DateTime?
  lockVersion          Int                          @default(0)
  owner                User                         @relation(fields: [ownerUserId], references: [userId], onDelete: Restrict)
  template             AssessmentTemplate           @relation(fields: [assessmentTemplateId], references: [assessmentTemplateId], onDelete: Restrict)
  syllabusVersion      SyllabusVersion              @relation(fields: [syllabusVersionId], references: [canonicalId], onDelete: Restrict)
  placements           AssessmentSessionPlacement[]
  responses            AssessmentResponse[]
  test                 TestDefinition?

  @@index([ownerUserId, state, createdAt])
  @@index([expiresAt, state])
  @@map("assessment_sessions")
}

model TestDefinition {
  testId                 String             @id @default(uuid()) @db.Uuid
  ownerUserId            String             @db.Uuid
  assessmentSessionId    String             @unique @db.Uuid
  academicVersionId      String
  testType               TestType
  targetScope            Json
  requestedQuestionCount Int
  durationSeconds        Int
  selectionContext       Json
  state                  TestLifecycleState @default(READY)
  createdAt              DateTime           @default(now())
  startedAt              DateTime?
  expiresAt              DateTime?
  completedAt            DateTime?
  owner                  User               @relation(fields: [ownerUserId], references: [userId], onDelete: Restrict)
  academicVersion        SyllabusVersion    @relation(fields: [academicVersionId], references: [canonicalId], onDelete: Restrict)
  assessmentSession      AssessmentSession  @relation(fields: [assessmentSessionId], references: [assessmentSessionId], onDelete: Restrict)

  @@index([ownerUserId, state, createdAt])
  @@map("test_definitions")
}

model AssessmentSessionPlacement {
  assessmentSessionPlacementId String                       @id @default(uuid()) @db.Uuid
  assessmentSessionId          String                       @db.Uuid
  questionVersionId            String                       @db.Uuid
  section                      String?
  ordinal                      Int
  attemptNumber                Int                          @default(1)
  retryOfPlacementId           String?                      @db.Uuid
  placementMetadata            Json?
  selectionReference           String?
  createdAt                    DateTime                     @default(now())
  session                      AssessmentSession            @relation(fields: [assessmentSessionId], references: [assessmentSessionId], onDelete: Cascade)
  questionVersion              QuestionVersion              @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)
  responses                    AssessmentResponse[]
  retryOf                      AssessmentSessionPlacement?  @relation("PlacementRetry", fields: [retryOfPlacementId], references: [assessmentSessionPlacementId], onDelete: Restrict)
  retries                      AssessmentSessionPlacement[] @relation("PlacementRetry")

  @@unique([assessmentSessionId, ordinal, attemptNumber])
  @@index([assessmentSessionId, section, ordinal])
  @@map("assessment_session_placements")
}

model AssessmentResponse {
  assessmentResponseId String                     @id @default(uuid()) @db.Uuid
  userId               String                     @db.Uuid
  assessmentSessionId  String                     @db.Uuid
  placementId          String                     @db.Uuid
  questionVersionId    String                     @db.Uuid
  responsePayload      Json
  correctness          String
  score                Int
  idempotencyKey       String
  requestFingerprint   String
  submittedAt          DateTime                   @default(now())
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  user                 User                       @relation(fields: [userId], references: [userId], onDelete: Restrict)
  session              AssessmentSession          @relation(fields: [assessmentSessionId], references: [assessmentSessionId], onDelete: Cascade)
  placement            AssessmentSessionPlacement @relation(fields: [placementId], references: [assessmentSessionPlacementId], onDelete: Restrict)
  questionVersion      QuestionVersion            @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@unique([assessmentSessionId, placementId])
  @@index([assessmentSessionId, placementId])
  @@map("assessment_responses")
}

model DiagnosticRun {
  diagnosticRunId          String                @id @default(uuid()) @db.Uuid
  userId                   String                @db.Uuid
  academicVersionId        String
  rootTargetConceptId      String
  currentTargetConceptId   String
  currentDifficulty        String
  sessionId                String?               @db.Uuid
  status                   DiagnosticStatus      @default(ACTIVE)
  questionCount            Int                   @default(0)
  processedResponseIds     String[]
  conceptEvidence          Json
  path                     Json
  currentPlacementId       String?               @db.Uuid
  currentQuestionVersionId String?               @db.Uuid
  stopReason               DiagnosticStopReason?
  policyVersion            String                @default("C016-DEP-GC-V1")
  lockVersion              Int                   @default(0)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  completedAt              DateTime?
  user                     User                  @relation(fields: [userId], references: [userId], onDelete: Restrict)
  academicVersion          SyllabusVersion       @relation(fields: [academicVersionId], references: [canonicalId], onDelete: Restrict)

  @@unique([userId, academicVersionId, rootTargetConceptId, status])
  @@index([userId, status])
  @@map("diagnostic_runs")
}

model ConfigurationSet {
  configurationSetId String                 @id @default(uuid()) @db.Uuid
  scopeKey           String
  examId             String
  subjectId          String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  versions           ConfigurationVersion[]

  @@unique([examId, subjectId])
  @@unique([scopeKey])
  @@map("configuration_sets")
}

model AcademicIssue {
  issueId       String             @id @default(uuid()) @db.Uuid
  sourceType    String
  sourceRef     String
  examId        String?
  subjectId     String?
  summary       String
  status        AcademicIssueStatus @default(OPEN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  pilotId       String?            @db.Uuid
  pilot         Pilot?             @relation(fields: [pilotId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([pilotId, status, createdAt])
  @@map("academic_issues")
}

model Pilot {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  status      PilotStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime?
  ownerUserId String     @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation("PilotOwners", fields: [ownerUserId], references: [userId], onDelete: Restrict)
  participants PilotParticipant[]
  academicIssues AcademicIssue[]

  @@index([status, startsAt])
  @@index([ownerUserId])
  @@map("pilots")
}

model PilotParticipant {
  pilotId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  pilot     Pilot    @relation(fields: [pilotId], references: [id], onDelete: Restrict)
  user      User     @relation("PilotParticipants", fields: [userId], references: [userId], onDelete: Restrict)

  @@id([pilotId, userId])
  @@index([userId])
  @@map("pilot_participants")
}

model ConfigurationVersion {
  configurationVersionId String                     @id @default(uuid()) @db.Uuid
  configurationSetId     String                     @db.Uuid
  versionNumber          Int
  status                 ConfigurationVersionStatus @default(DRAFT)
  createdByUserId        String                     @db.Uuid
  reason                 String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  configurationSet       ConfigurationSet           @relation(fields: [configurationSetId], references: [configurationSetId], onDelete: Restrict)
  createdBy              User                       @relation("ConfigurationVersionCreators", fields: [createdByUserId], references: [userId], onDelete: Restrict)
  changes                ConfigurationChange[]
  approvals              ConfigurationApproval[]
  publications           ConfigurationPublication[]
  rollbacksFrom          ConfigurationRollback[]    @relation("RollbackSource")
  rollbacksTo            ConfigurationRollback[]    @relation("RollbackTarget")

  @@unique([configurationSetId, versionNumber])
  @@index([configurationSetId, status])
  @@map("configuration_versions")
}

model ConfigurationChange {
  configurationChangeId  String               @id @default(uuid()) @db.Uuid
  configurationVersionId String               @db.Uuid
  changeKey              String
  beforeValue            Json?
  afterValue             Json
  actorUserId            String               @db.Uuid
  reason                 String
  createdAt              DateTime             @default(now())
  version                ConfigurationVersion @relation(fields: [configurationVersionId], references: [configurationVersionId], onDelete: Restrict)
  actor                  User                 @relation("ConfigurationChangeActors", fields: [actorUserId], references: [userId], onDelete: Restrict)

  @@unique([configurationVersionId, changeKey])
  @@map("configuration_changes")
}

model ConfigurationApproval {
  configurationApprovalId String                        @id @default(uuid()) @db.Uuid
  configurationVersionId  String                        @db.Uuid
  actorUserId             String                        @db.Uuid
  decision                ConfigurationApprovalDecision
  reason                  String
  correlationId           String
  createdAt               DateTime                      @default(now())
  version                 ConfigurationVersion          @relation(fields: [configurationVersionId], references: [configurationVersionId], onDelete: Restrict)
  actor                   User                          @relation(fields: [actorUserId], references: [userId], onDelete: Restrict)

  @@unique([configurationVersionId, actorUserId])
  @@index([correlationId])
  @@map("configuration_approvals")
}

model ConfigurationPublication {
  configurationPublicationId String               @id @default(uuid()) @db.Uuid
  configurationVersionId     String               @db.Uuid
  actorUserId                String               @db.Uuid
  previousVersionId          String?              @db.Uuid
  reason                     String
  correlationId              String
  createdAt                  DateTime             @default(now())
  version                    ConfigurationVersion @relation(fields: [configurationVersionId], references: [configurationVersionId], onDelete: Restrict)
  actor                      User                 @relation(fields: [actorUserId], references: [userId], onDelete: Restrict)

  @@unique([configurationVersionId])
  @@index([correlationId])
  @@map("configuration_publications")
}

model ConfigurationRollback {
  configurationRollbackId String               @id @default(uuid()) @db.Uuid
  sourceVersionId         String               @db.Uuid
  targetVersionId         String               @db.Uuid
  actorUserId             String               @db.Uuid
  reason                  String
  correlationId           String
  createdAt               DateTime             @default(now())
  sourceVersion           ConfigurationVersion @relation("RollbackSource", fields: [sourceVersionId], references: [configurationVersionId], onDelete: Restrict)
  targetVersion           ConfigurationVersion @relation("RollbackTarget", fields: [targetVersionId], references: [configurationVersionId], onDelete: Restrict)
  actor                   User                 @relation(fields: [actorUserId], references: [userId], onDelete: Restrict)

  @@unique([sourceVersionId, targetVersionId, correlationId])
  @@index([targetVersionId])
  @@map("configuration_rollbacks")
}

model Question {
  questionId      String            @id @default(uuid()) @db.Uuid
  scopeKey        String
  examId          String
  subjectId       String
  createdByUserId String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  exam            AcademicExam      @relation(fields: [examId], references: [canonicalId], onDelete: Restrict)
  subject         AcademicSubject   @relation(fields: [subjectId], references: [canonicalId], onDelete: Restrict)
  createdBy       User              @relation("QuestionCreators", fields: [createdByUserId], references: [userId], onDelete: Restrict)
  versions        QuestionVersion[]

  @@unique([scopeKey, questionId])
  @@index([examId, subjectId])
  @@map("questions")
}

model QuestionVersion {
  questionVersionId    String                       @id @default(uuid()) @db.Uuid
  questionId           String                       @db.Uuid
  versionNumber        Int
  status               QuestionVersionStatus        @default(DRAFT)
  questionType         QuestionType
  stem                 Json
  options              Json?
  correctAnswerRef     String?
  explanationRef       String?
  syllabusNodeId       String
  learningObjectiveId  String?
  locale               String                       @default("en-IN")
  createdByUserId      String                       @db.Uuid
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  question             Question                     @relation(fields: [questionId], references: [questionId], onDelete: Restrict)
  syllabusNode         SyllabusNode                 @relation(fields: [syllabusNodeId], references: [canonicalId], onDelete: Restrict)
  learningObjective    LearningObjective?           @relation(fields: [learningObjectiveId], references: [canonicalId], onDelete: Restrict)
  createdBy            User                         @relation("QuestionVersionCreators", fields: [createdByUserId], references: [userId], onDelete: Restrict)
  concepts             QuestionConceptMap[]
  difficulty           QuestionDifficulty?
  hints                QuestionHint[]
  solutions            QuestionSolution[]
  provenance           QuestionProvenance?
  rights               QuestionRights?
  reviews              QuestionReviewRecord[]
  exposures            QuestionExposure[]
  assessmentPlacements AssessmentSessionPlacement[]
  assessmentResponses  AssessmentResponse[]

  @@unique([questionId, versionNumber])
  @@index([questionId, status])
  @@index([syllabusNodeId])
  @@map("question_versions")
}

model QuestionExposure {
  questionExposureId  String          @id @default(uuid()) @db.Uuid
  userId              String          @db.Uuid
  questionVersionId   String          @db.Uuid
  syllabusVersionId   String
  selectedAt          DateTime        @default(now())
  sessionId           String?
  selectionReasonCode String
  user                User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  questionVersion     QuestionVersion @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)
  syllabusVersion     SyllabusVersion @relation(fields: [syllabusVersionId], references: [canonicalId], onDelete: Restrict)

  @@index([userId, syllabusVersionId, selectedAt])
  @@index([questionVersionId])
  @@map("question_exposures")
}

model QuestionConceptMap {
  questionConceptMapId String              @id @default(uuid()) @db.Uuid
  questionVersionId    String              @db.Uuid
  conceptId            String
  mappingRole          QuestionMappingRole
  approved             Boolean             @default(false)
  createdByUserId      String              @db.Uuid
  createdAt            DateTime            @default(now())
  questionVersion      QuestionVersion     @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)
  concept              AcademicConcept     @relation(fields: [conceptId], references: [canonicalId], onDelete: Restrict)
  createdBy            User                @relation("QuestionConceptMapCreators", fields: [createdByUserId], references: [userId], onDelete: Restrict)

  @@unique([questionVersionId, conceptId])
  @@index([conceptId, approved])
  @@map("question_concept_maps")
}

model QuestionDifficulty {
  questionDifficultyId String          @id @default(uuid()) @db.Uuid
  questionVersionId    String          @unique @db.Uuid
  authorDifficulty     Int?
  empiricalDifficulty  Float?
  calibratedDifficulty Float?
  confidence           Float?
  provenance           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  questionVersion      QuestionVersion @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)

  @@map("question_difficulty")
}

model QuestionHint {
  questionHintId    String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @db.Uuid
  sequence          Int
  content           Json
  isFinalHint       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)

  @@unique([questionVersionId, sequence])
  @@map("question_hints")
}

model QuestionSolution {
  questionSolutionId String          @id @default(uuid()) @db.Uuid
  questionVersionId  String          @db.Uuid
  solutionKey        String
  content            Json
  createdAt          DateTime        @default(now())
  questionVersion    QuestionVersion @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)

  @@unique([questionVersionId, solutionKey])
  @@map("question_solutions")
}

model QuestionProvenance {
  questionProvenanceId String             @id @default(uuid()) @db.Uuid
  questionVersionId    String             @unique @db.Uuid
  authorOrSource       String
  originType           QuestionOriginType
  sourceReference      String?
  creationMethod       String
  attribution          String?
  reviewNotes          String?
  verificationStatus   String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  questionVersion      QuestionVersion    @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)

  @@map("question_provenance")
}

model QuestionRights {
  questionRightsId     String               @id @default(uuid()) @db.Uuid
  questionVersionId    String               @unique @db.Uuid
  license              String
  rightsStatus         QuestionRightsStatus
  commercialUseAllowed Boolean
  restrictionNotes     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  questionVersion      QuestionVersion      @relation(fields: [questionVersionId], references: [questionVersionId], onDelete: Restrict)

  @@map("question_rights")
}

model QuestionReviewRecord {
  questionReviewRecordId String                 @id @default(uuid()) @db.Uuid
  questionVersionId      String                 @db.Uuid
  reviewerUserId         String                 @db.Uuid
  reviewType             QuestionReviewType
  decision               QuestionReviewDecision
  reviewScope            String
  reason                 String
  correlationId          String
  beforeReference        Json?
  afterReference         Json?
