  source    AcademicConcept          @relation("ConceptRelationshipSource", fields: [sourceId], references: [canonicalId], onDelete: Restrict)
  target    AcademicConcept          @relation("ConceptRelationshipTarget", fields: [targetId], references: [canonicalId], onDelete: Restrict)

  @@id([versionId, sourceId, type, targetId])
  @@index([versionId, targetId])
  @@map("concept_relationships")
}

model SyllabusVersion {
  canonicalId         String                    @id
  humanVersion        String
  status              SyllabusVersionStatus
  current             Boolean                   @default(false)
  effectiveYear       Int
  examId              String
  subjectId           String
  exam                AcademicExam              @relation(fields: [examId], references: [canonicalId], onDelete: Restrict)
  subject             AcademicSubject           @relation(fields: [subjectId], references: [canonicalId], onDelete: Restrict)
  syllabusNodes       SyllabusVersionNode[]
  conceptMappings     SyllabusVersionConcept[]
  syllabusMappings    SyllabusConceptMapping[]
  objectiveMappings   ObjectiveConceptMapping[]
  relationships       ConceptRelationship[]
  questionExposures   QuestionExposure[]
  assessmentTemplates AssessmentTemplate[]
  assessmentSessions  AssessmentSession[]
  diagnosticRuns      DiagnosticRun[]
  practiceSessions    PracticeSession[]
  tests               TestDefinition[]

  @@unique([examId, subjectId, current])
  @@index([examId, subjectId, status, current])
  @@map("syllabus_versions")
}

model SyllabusVersionNode {
  versionId      String
  syllabusNodeId String
  version        SyllabusVersion @relation(fields: [versionId], references: [canonicalId], onDelete: Cascade)
  syllabusNode   SyllabusNode    @relation(fields: [syllabusNodeId], references: [canonicalId], onDelete: Restrict)

  @@id([versionId, syllabusNodeId])
  @@index([syllabusNodeId])
  @@map("syllabus_version_nodes")
}

model SyllabusVersionConcept {
  versionId String
  conceptId String
  version   SyllabusVersion @relation(fields: [versionId], references: [canonicalId], onDelete: Cascade)
  concept   AcademicConcept @relation(fields: [conceptId], references: [canonicalId], onDelete: Restrict)

  @@id([versionId, conceptId])
  @@map("syllabus_version_concepts")
}

model LearningObjective {
  canonicalId      String                    @id
  description      String
  concepts         ObjectiveConceptMapping[]
  questionVersions QuestionVersion[]

  @@map("learning_objectives")
}

model SyllabusConceptMapping {
  versionId      String
  syllabusNodeId String
  conceptId      String
  version        SyllabusVersion @relation(fields: [versionId], references: [canonicalId], onDelete: Cascade)
  syllabusNode   SyllabusNode    @relation(fields: [syllabusNodeId], references: [canonicalId], onDelete: Restrict)
  concept        AcademicConcept @relation(fields: [conceptId], references: [canonicalId], onDelete: Restrict)

  @@id([versionId, syllabusNodeId, conceptId])
  @@index([syllabusNodeId, conceptId])
  @@map("syllabus_concept_mappings")
}

model ObjectiveConceptMapping {
  versionId   String
  objectiveId String
  conceptId   String
  version     SyllabusVersion   @relation(fields: [versionId], references: [canonicalId], onDelete: Cascade)
  objective   LearningObjective @relation(fields: [objectiveId], references: [canonicalId], onDelete: Restrict)
  concept     AcademicConcept   @relation(fields: [conceptId], references: [canonicalId], onDelete: Restrict)

  @@id([versionId, objectiveId, conceptId])
  @@index([objectiveId, conceptId])
  @@map("objective_concept_mappings")
}
